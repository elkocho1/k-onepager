---
/**
 * Hero (spec section 1, Figma 139:14 / mobile 242:22): full-width banner with
 * an even night overlay, text block, two buttons.
 *
 * Three layers under the copy, bottom to top: the photo (LCP element, eager
 * and high priority – it also stands in as the video's poster, so no second
 * download of the same frame), the background video and the night overlay.
 * The overlay lies over the *whole* banner at one opacity
 * (--hero-overlay-rest); the two 50 %-high gradients it replaces met in the
 * middle of the image with different end values and drew a visible edge there.
 *
 * From 768px the headline is ONE centred line "Build Beyond." sized to fill
 * the content container – the start frame of the push-through scroll
 * (docs/DESIGN-SPEC.md section 1, deliberate deviation 9). Below 768px the two
 * lines stay stacked and left-aligned as in the mobile frame 242:22.
 *
 * The headline is split into one <span> per letter at build time for the type
 * intro (phase 7, item 1 – animations.ts); screen readers get the plain text
 * from a visually hidden copy, the letter spans are aria-hidden.
 *
 * On load only the headline and the scroll hint are on screen; eyebrow, copy
 * and buttons are hidden by JS and rise in once the fly-through is over.
 *
 * Motion hooks (animations.ts, phase 7 item 1 + 2):
 *   [data-hero-push]    every layer that shares the push-through scale. Today
 *                       only the type wrapper; a later mask layer carries the
 *                       same attribute and joins the tween without a rebuild.
 *   [data-hero-type]    the type itself – dissolves at the end of the fly-through
 *   [data-hero-overlay] night overlay, darkens from --hero-overlay-rest to 1
 *   [data-parallax]     photo and video – they widen together with the type
 *   [data-hero-video]   background video, activated by hero-video.ts
 *   [data-hero-hint]    scroll hint, fades out over the first 15 % of the scroll
 *   [data-hero-eyebrow] · [data-hero-text] (+ [data-hero-text-line]) ·
 *   [data-hero-actions] the three blocks that appear after the fly-through, in
 *                       that order. The copy rests at its final size
 *                       (--hero-copy-scale on font-size, no transform).
 */
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import { content, nl2br } from '../lib/content';
import { resolveImage } from '../lib/images';

const { hero } = content;
const image = resolveImage(hero.image.src);
const textLines = nl2br(hero.text);
---

<section class="hero" data-hero data-hex-block>
  <Picture
    src={image}
    alt={hero.image.alt}
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    formats={['avif', 'webp']}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="hero__image"
    pictureAttributes={{ class: 'hero__picture', 'data-parallax': '' }}
  />
  <!-- The two spellings are what Astro's VideoHTMLAttributes accept (lowercase
       for the one, camelCase for the other); both render as HTML attributes. -->
  <video
    class="hero__video"
    data-hero-video
    data-parallax
    data-src={hero.video.src}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    disablepictureinpicture
    disableRemotePlayback
    aria-hidden="true"
  ></video>
  <div class="hero__overlay" data-hero-overlay aria-hidden="true"></div>
  <div class="container">
    <div class="hero__content" data-hero-content>
      <p class="eyebrow hero__eyebrow" data-hero-eyebrow>{hero.eyebrow}</p>
      <h1 class="hero__title">
        <span class="visually-hidden">{hero.headline.join(' ')}</span>
        <span class="hero__zoom" data-hero-push data-hero-type aria-hidden="true">
          <span class="hero__line">
            {hero.headline.map((word, index) => (
              <span
                class:list={['hero__word', { 'outline-text': index === 1 }]}
                data-hero-word={index === 1 ? 'outline' : 'solid'}
              >{[...word].map((char) => <span class="char" data-hero-char>{char}</span>)}</span>
            ))}
          </span>
        </span>
      </h1>
      <p class="body hero__text" data-hero-text>
        {textLines.map((line) => <span class="hero__text-line" data-hero-text-line>{line}</span>)}
      </p>
      <div class="hero__actions" data-hero-actions>
        <Button href={hero.primaryCta.href} label={hero.primaryCta.label} variant="primary" />
        <Button href={hero.secondaryCta.href} label={hero.secondaryCta.label} variant="secondary" />
      </div>
    </div>
  </div>
  <p class="hero__hint" data-hero-hint aria-hidden="true">{hero.scrollHint}</p>
</section>

<script src="../scripts/hero-video.ts"></script>

<style>
  .hero {
    /* Resting opacity of the night overlay. Measured against the brightest
       8x8 patch inside the headline box over the whole video loop: white
       4.44:1 and the lime outline 3.78:1 at worst (0.35 dropped the outline to
       2.90:1, under the 3:1 bar for display type). The push-through animates
       from here to 1 (animations.ts). */
    --hero-overlay-rest: 0.45;
    /* How much larger the hero copy is than body text after the fly-through.
       It drives font-size and max-width – NOT a transform: a block resting on
       scale(1.5) is permanently resampled and the text looks soft. 1 below
       768px (no reveal there). */
    --hero-copy-scale: 1.5;
    /* Width of a space in KMR Apparat Heavy, measured – the words are spaced
       with a margin instead of a text node so they can stack on mobile */
    --hero-word-gap: 0.215em;

    position: relative;
    isolation: isolate;
    /* Ground under every layer: should a rounding gap ever open at an edge it
       shows night, not video (see .hero__overlay) */
    background-color: var(--c-night);
    display: grid;
    align-items: center;
    /* The pinned push-through needs the whole viewport (spec deviation 9);
       the Figma frame is 936px tall */
    min-height: 100svh;
    padding-top: 60px; /* text block centred +30px (spec) */
    overflow: hidden;
  }

  /* Bottom layer: the photo. Also the video's stand-in poster. */
  .hero :global(.hero__picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero :global(.hero__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Background video over the photo, same framing. It carries no `src` in the
     markup – hero-video.ts sets it once the hero is in view, and only there
     (not at reduced motion, not below 768px). Until it plays it is fully
     transparent, so without JS the photo stands alone and the video never
     covers it as a black plate. */
  .hero__video {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  /* One even layer over the whole banner: it carries the photo far enough
     towards night for the copy to stand (--hero-overlay-rest) and the
     push-through takes it the rest of the way (animations.ts). Its resting
     value is CSS, so without JS and at reduced motion the banner looks the
     same as at timeline position 0 – a decorative layer, no content hides
     here. */
  /* Two lines here fix one measured artefact: after the pin the hero box lands
     on a fractional CSS pixel (measured: bottom 933.001 at DPR 1), and one
     device row of the scaled video showed below the overlay.
       – `inset: -1px 0` puts the overlay's box past that fractional edge; the
         overhang is clipped away, so nothing changes visually.
       – `will-change: opacity` puts it on its own compositor layer, which the
         hero's overflow clips with the same rounding as the video's layer
         (the overlay animates opacity anyway).
     Each alone leaves the row uncovered – verified in both directions. */
  .hero__overlay {
    position: absolute;
    inset: -1px 0;
    z-index: 0;
    will-change: opacity;
    background: var(--c-night);
    opacity: var(--hero-overlay-rest);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    text-align: center;
    /* --fs-display is derived from this width (tokens.css) */
    container-type: inline-size;
  }

  .hero__eyebrow {
    padding-inline: 16px;
  }

  .hero__title {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: var(--lh-display);
    color: var(--c-white);
  }

  /* The layer the push-through scales – kept separate from the <h1> so a mask
     layer can later scale in lockstep with it */
  .hero__zoom {
    display: block;
    transform-origin: 50% 50%;
  }

  .hero__line {
    display: block;
    white-space: nowrap;
  }

  .hero__word + .hero__word {
    margin-left: var(--hero-word-gap);
  }

  /* Outline word "Beyond." – the negative margin drops the letter-space that
     trails the last glyph so the line is optically centred */
  .hero__title [data-hero-word='outline'] {
    letter-spacing: var(--ls-outline-hero);
    margin-right: calc(-1 * var(--ls-outline-hero));
  }

  /* One inline-block per letter so GSAP can move them (the inherited
     letter-spacing and text-stroke still apply per glyph) */
  .hero__title .char {
    display: inline-block;
  }

  /* The copy rests at its final size: font-size and max-width carry the factor
     (--lh-body is a ratio, so the line height follows), and the reveal leaves
     no transform behind. Same rendered result as the former scale(1.5), but
     rasterised at its real size instead of resampled. */
  .hero__text {
    font-size: calc(var(--fs-body) * var(--hero-copy-scale));
    max-width: min(calc(809px * var(--hero-copy-scale)), 100cqw);
  }

  .hero__text-line {
    display: block;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  /* On load the headline is the only copy on screen – this says where to go.
     Fades out over the first 15 % of the scroll (animations.ts). */
  .hero__hint {
    position: absolute;
    bottom: 40px;
    left: 50%;
    translate: -50% 0; /* CSS translate, so GSAP owns `transform` alone */
    z-index: 1;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--ls-hint);
    text-transform: uppercase;
    color: var(--c-muted);
    pointer-events: none;
  }

  .hero__hint::before {
    content: '';
    display: block;
    width: 1px;
    height: 48px;
    margin: 0 auto 16px;
    background: linear-gradient(180deg, transparent, var(--c-muted));
  }

  @media (max-width: 767px) {
    /* Mobile frame 242:22: 780 tall, text block bottom-aligned and left, gaps
       20, headline stacked – capped at the viewport height so short screens
       never hide the buttons. No pin here, only scale and fade (phase 7). */
    .hero {
      --hero-copy-scale: 1;
      align-items: end;
      min-height: min(780px, 100svh);
      padding-top: var(--scroll-offset);
      padding-bottom: 56px;
    }

    .hero__content {
      align-items: flex-start;
      gap: 20px;
      text-align: left;
    }

    .hero__word {
      display: block;
    }

    .hero__word + .hero__word {
      margin-left: 0;
      margin-top: -6px; /* lines overlap by 6px (mobile frame 242:22) */
    }

    /* Mobile frame 242:22: outline line without tracking */
    .hero__title [data-hero-word='outline'] {
      letter-spacing: normal;
      margin-right: 0;
    }

    /* No fly-through below 768px, so eyebrow, copy and buttons are visible
       from the start and the hint has nothing to announce */
    .hero__hint {
      display: none;
    }

    .hero__actions {
      flex-direction: column;
      align-self: stretch;
      gap: 12px;
    }

    .hero__actions .btn {
      width: 100%;
      height: 46px;
    }
  }
</style>
