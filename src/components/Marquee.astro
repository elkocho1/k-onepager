---
/**
 * Marquee (spec section 4, Figma 139:59 / mobile 242:70): two full-bleed
 * rows of "Build beyond." claims, every second entry as teal outline, edges
 * fading into night. Decorative (aria-hidden). Each row renders its entries
 * twice so phase 7 can loop it seamlessly; static state: row 1 aligned to
 * the end, row 2 to the start.
 */
import { content } from '../lib/content';

const { marquee } = content;
const copies = [0, 1];
---

<div class="marquee" aria-hidden="true" data-marquee>
  {marquee.rows.map((row, rowIndex) => (
    <div
      class:list={['marquee__row', rowIndex === 0 ? 'marquee__row--end' : 'marquee__row--start']}
      data-marquee-direction={rowIndex === 0 ? 'left' : 'right'}
    >
      <div class="marquee__track">
        {copies.map(() =>
          row.map((item, index) => (
            <span class:list={['marquee__item', { 'outline-text': (index + rowIndex) % 2 === 0 }]}>{item}</span>
          )),
        )}
      </div>
    </div>
  ))}
</div>

<style>
  .marquee {
    --outline-color: var(--c-teal);
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 80px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 522px, #000 calc(100% - 522px), transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 522px, #000 calc(100% - 522px), transparent);
  }

  .marquee__row {
    display: flex;
    height: 55px;
    align-items: center;
    overflow: hidden;
  }

  .marquee__row--end {
    justify-content: flex-end;
  }

  .marquee__row--start {
    justify-content: flex-start;
  }

  .marquee__track {
    display: flex;
    flex: none;
    gap: 50px;
    width: max-content;
    white-space: nowrap;
  }

  .marquee__item {
    font-size: var(--fs-marquee);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: var(--ls-h2);
    color: var(--c-teal);
  }

  /* Same treatment as .outline-text in the hero – repeated here because the
     scoped .marquee__item selector outranks the global utility. */
  .marquee__item.outline-text {
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 2px var(--c-teal);
  }

  @media (max-width: 767px) {
    .marquee {
      margin-top: var(--section-gap);
      gap: 10px;
      mask-image: linear-gradient(90deg, transparent, #000 60px, #000 calc(100% - 60px), transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 60px, #000 calc(100% - 60px), transparent);
    }

    .marquee__row {
      height: 40px;
    }
  }
</style>
