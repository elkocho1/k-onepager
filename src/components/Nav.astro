---
/**
 * Fixed site header (spec section 0, Figma 139:32 / mobile 242:27).
 * Transparent on the hero; `.is-scrolled` (toggled from 40px scroll by
 * src/scripts/animations.ts) adds the night background and blur, the current
 * section's link carries aria-current. Mobile shows only the logo (spec
 * deviation 7).
 */
import Button from './Button.astro';
import { content } from '../lib/content';
import { publicImageSize } from '../lib/images';

const { nav } = content;
const logo = await publicImageSize(nav.logo);
---

<header class="site-header" data-nav>
  <div class="site-header__inner container">
    <a href="/" class="site-header__logo">
      <img src={nav.logo} alt={nav.logoAlt} width={logo.width} height={logo.height} decoding="async" />
    </a>
    <nav class="site-header__nav" aria-label={nav.ariaLabel}>
      <ul role="list">
        {nav.items.map((item) => (
          <li>
            <a href={item.anchor}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <Button href={nav.cta.href} label={nav.cta.label} variant="primary" class="site-header__cta" />
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: var(--nav-top) 0 auto 0;
    z-index: 100;
    transition:
      background-color var(--dur-base) var(--ease-out),
      top var(--dur-base) var(--ease-out);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    height: var(--nav-height);
    transition: height var(--dur-base) var(--ease-out);
  }

  .site-header__logo {
    display: block;
    flex: none;
  }

  .site-header__logo img {
    height: 60px;
    width: auto;
  }

  .site-header__nav ul {
    display: flex;
    gap: 30px;
  }

  /* 44px target height inside the 60px bar */
  .site-header__nav a {
    display: inline-block;
    padding-block: 12.5px;
    font-size: var(--fs-nav);
    font-weight: 400;
    color: var(--c-teal);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='true'] {
    color: var(--c-white);
  }

  .site-header__nav a[aria-current='true'] {
    font-weight: 350;
  }

  .site-header__cta {
    width: 222px;
    flex: none;
  }

  /* Scroll state – class toggled by animations.ts, transition above */
  .site-header.is-scrolled {
    top: 0;
    background: var(--c-night-a85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .site-header.is-scrolled .site-header__inner {
    height: var(--nav-height-scrolled);
  }

  /* Tablet: links hidden like on mobile (no burger menu – decided, spec deviation 7), CTA stays */
  @media (max-width: 1023px) {
    .site-header__nav {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .site-header {
      top: 0;
    }

    .site-header__inner {
      height: var(--nav-height-scrolled);
      justify-content: flex-start;
    }

    /* 36px logo + 4px padding each side = 44px target */
    .site-header__logo {
      padding-block: 4px;
    }

    .site-header__logo img {
      height: 36px;
    }

    .site-header__nav,
    .site-header__cta {
      display: none;
    }
  }
</style>
