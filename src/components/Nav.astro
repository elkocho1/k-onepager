---
/**
 * Fixed site header (spec section 0, Figma 139:32 / mobile 242:27).
 * Transparent on the hero; `.is-scrolled` (toggled from 40px scroll by
 * src/scripts/animations.ts) adds the night background and blur, the current
 * section's link carries aria-current. Mobile shows only the logo (spec
 * deviation 7). The bar never moves: on scroll it keeps its --nav-top offset
 * and only the background grows up to the viewport edge (spec deviation 12).
 *
 * Bar height and logo width are scroll-coupled while the hero is left
 * (animations.ts, initNavShrink): both glide on one scrubbed trigger from
 * --nav-height / --nav-logo-width to --nav-height-scrolled /
 * --nav-logo-width-min. The class rules below are the resting state that
 * holds without JS and at reduced motion; with motion, GSAP's inline values
 * take over. Nothing here transitions height or width – a CSS transition on
 * a property GSAP tweens fights the scrub.
 */
import Button from './Button.astro';
import { content } from '../lib/content';
import { home, withBase } from '../lib/paths';
import { publicImageSize } from '../lib/images';

const { nav } = content;
const logo = await publicImageSize(nav.logo);
---

<header class="site-header" data-nav>
  <div class="site-header__inner container" data-nav-inner>
    <a href={home} class="site-header__logo">
      <img
        src={withBase(nav.logo)}
        alt={nav.logoAlt}
        width={logo.width}
        height={logo.height}
        decoding="async"
        data-nav-logo
      />
    </a>
    <nav class="site-header__nav" aria-label={nav.ariaLabel}>
      <ul role="list">
        {nav.items.map((item) => (
          <li>
            <a href={item.anchor}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <Button href={nav.cta.href} label={nav.cta.label} variant="primary" class="site-header__cta" />
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: var(--nav-top) 0 auto 0;
    z-index: 100;
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    height: var(--nav-height);
  }

  .site-header__logo {
    display: block;
    flex: none;
  }

  /* Width-driven so the scrub can glide it; the intrinsic 481x165 keeps the
     ratio (174 -> 59.7 high, 120 -> 41.2) */
  .site-header__logo img {
    width: var(--nav-logo-width);
    height: auto;
  }

  .site-header__nav ul {
    display: flex;
    gap: 30px;
  }

  /* 44px target height inside the 60px bar */
  .site-header__nav a {
    display: inline-block;
    padding-block: 12.5px;
    font-size: var(--fs-nav);
    font-weight: 400;
    color: var(--c-teal);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='true'] {
    color: var(--c-white);
  }

  .site-header__nav a[aria-current='true'] {
    font-weight: 350;
  }

  .site-header__cta {
    width: 222px;
    flex: none;
  }

  /* Scroll state – class toggled by animations.ts, transition above. The
     top offset moves into padding, so the content stays exactly where it is
     while the background reaches the viewport edge (no dock, deviation 12). */
  .site-header.is-scrolled {
    top: 0;
    padding-top: var(--nav-top);
    background: var(--c-night-a85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .site-header.is-scrolled .site-header__inner {
    height: var(--nav-height-scrolled);
  }

  .site-header.is-scrolled .site-header__logo img {
    width: var(--nav-logo-width-min);
  }

  /* Tablet: links hidden like on mobile (no burger menu – decided, spec deviation 7), CTA stays */
  @media (max-width: 1023px) {
    .site-header__nav {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .site-header,
    .site-header.is-scrolled {
      top: 0;
      padding-top: 0;
    }

    .site-header__inner {
      height: var(--nav-height-scrolled);
      justify-content: flex-start;
    }

    /* 36px logo + 4px padding each side = 44px target */
    .site-header__logo {
      padding-block: 4px;
    }

    /* Mobile frame 242:27: height-driven 36px logo, no scroll coupling */
    .site-header__logo img,
    .site-header.is-scrolled .site-header__logo img {
      width: auto;
      height: 36px;
    }

    .site-header__nav,
    .site-header__cta {
      display: none;
    }
  }
</style>
