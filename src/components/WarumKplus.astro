---
/**
 * Warum K+ (spec section 5, Figma 139:72 / mobile 242:81): header with
 * eyebrow, h2 and slider label, a horizontally scrollable row of six cards
 * (five features + one statement) with scroll snapping, and a progress line
 * with counter. Mobile stacks the cards; the progress UI is hidden there.
 * Icons are inlined at build time from public/icons/warum/<icon>.svg.
 */
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { content } from '../lib/content';

const { warumKplus } = content;
const total = warumKplus.cards.length + 1; // + statement card
const pad = (n: number) => String(n).padStart(2, '0');

const icons = Object.fromEntries(
  await Promise.all(
    warumKplus.cards.map(async (card) => [
      card.icon,
      await readFile(path.join(process.cwd(), 'public', 'icons', 'warum', `${card.icon}.svg`), 'utf8'),
    ]),
  ),
) as Record<string, string>;
---

<section id={warumKplus.id} class="warum">
  <div class="container warum__head">
    <div class="warum__heading">
      <p class="eyebrow warum__eyebrow">{warumKplus.eyebrow}</p>
      <h2 class="h2">{warumKplus.headline}</h2>
    </div>
    <p class="warum__label">{warumKplus.sliderLabel}</p>
  </div>

  <ul class="cards" role="list" tabindex="0" aria-label={warumKplus.trackLabel} data-cards>
    {warumKplus.cards.map((card) => (
      <li class="card">
        <span class="card__glow" aria-hidden="true"></span>
        <span class="card__icon" set:html={icons[card.icon]} />
        <div class="card__body">
          <h3 class="card__title">{card.title}</h3>
          <p class="card__text">{card.text}</p>
        </div>
      </li>
    ))}
    <li class="card card--statement">
      <span class="card__glow" aria-hidden="true"></span>
      <p class="card__statement">{warumKplus.statement}</p>
    </li>
  </ul>

  <div class="container warum__progress" aria-hidden="true">
    <div class="progress">
      <span class="progress__bar" style={`--progress: ${1 / total}`} data-progress-bar></span>
    </div>
    <span class="progress__count" data-progress-count>{pad(1)}/{pad(total)}</span>
  </div>
</section>

<script>
  // Progress line + counter follow the native scroll position (no GSAP).
  const track = document.querySelector<HTMLElement>('[data-cards]');
  const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
  const count = document.querySelector<HTMLElement>('[data-progress-count]');

  if (track && bar && count) {
    const cards = Array.from(track.children) as HTMLElement[];
    const total = cards.length;
    const pad = (n: number) => String(n).padStart(2, '0');
    let ticking = false;

    const update = () => {
      ticking = false;
      const maxScroll = track.scrollWidth - track.clientWidth;
      const ratio = maxScroll > 0 ? Math.min(1, track.scrollLeft / maxScroll) : 0;
      // Active card: the one whose start sits closest to the snap edge.
      const snapPadding = parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0; // "auto" → 0
      const edge = track.getBoundingClientRect().left + snapPadding;
      let active = 0;
      let best = Infinity;
      cards.forEach((card, index) => {
        const distance = Math.abs(card.getBoundingClientRect().left - edge);
        if (distance < best) {
          best = distance;
          active = index;
        }
      });
      bar.style.setProperty('--progress', String((1 + ratio * (total - 1)) / total));
      count.textContent = `${pad(active + 1)}/${pad(total)}`;
    };

    const schedule = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    track.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .warum {
    margin-top: var(--section-gap);
  }

  .warum__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .warum__heading {
    display: flex;
    flex-direction: column;
    gap: var(--gap-head);
  }

  .warum__eyebrow {
    max-width: 163px;
    white-space: normal;
  }

  .warum__label {
    flex: none;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--c-muted);
  }

  /* --- Card track --------------------------------------------------------- */
  .cards {
    /* Start edge = container edge (gutter, or centred container above 1920) */
    --track-start: max(var(--gutter), calc((100% - var(--container)) / 2));
    --card-width: 636px;
    display: flex;
    gap: 32px;
    margin-top: 40px;
    /* Trailing space lets the last card snap to the same start edge */
    padding-inline: var(--track-start) calc(100% - var(--track-start) - var(--card-width));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--track-start);
    scrollbar-width: none;
  }

  .cards::-webkit-scrollbar {
    display: none;
  }

  .cards:focus-visible {
    outline-offset: -3px;
  }

  .card {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 100px;
    width: var(--card-width);
    padding: 50px;
    overflow: hidden;
    border: 1px solid var(--c-night);
    background: var(--c-card-bg);
    scroll-snap-align: start;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .card__glow {
    position: absolute;
    top: -170px;
    left: -1px;
    width: 384px;
    height: 384px;
    border-radius: 50%;
    background: linear-gradient(142deg, var(--c-lime-a10) 43%, transparent 96%);
    filter: blur(32px);
    opacity: 0.5;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .card__icon {
    position: relative;
    display: block;
    width: 50px;
    height: 50px;
    color: var(--c-magenta);
  }

  .card__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .card__title {
    font-size: var(--fs-h3-card);
    font-weight: 400;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--c-teal);
  }

  .card__text {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-white);
  }

  .card--statement {
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .card__statement {
    position: relative;
    max-width: 536px;
    font-size: var(--fs-statement);
    line-height: var(--lh-statement);
    color: var(--c-teal);
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--c-teal-a30);
    }

    .card:hover .card__glow {
      opacity: 1;
    }
  }

  /* --- Progress line + counter -------------------------------------------- */
  /* Figma 139:185 is an 11px row with the counter overflowing it; the
     28px line box of the counter would otherwise push the following sections
     down by 17px. */
  .warum__progress {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 11px;
    margin-top: 40px;
  }

  .progress {
    position: relative;
    flex: 1 1 auto;
    max-width: 1540px;
    height: 1px;
    background: var(--c-teal-a30);
  }

  .progress__bar {
    position: absolute;
    inset: 0;
    background: var(--c-magenta); /* Figma 139:188 – active state, not text */
    transform: scaleX(var(--progress, 0.1667));
    transform-origin: left center;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .progress__count {
    flex: none;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  /* --- 1024–1439: narrower cards (phase 6) -------------------------------- */
  @media (max-width: 1439px) {
    .cards {
      --card-width: 560px;
    }
  }

  /* --- Tablet: scrollable, narrower cards --------------------------------- */
  @media (max-width: 1023px) {
    .cards {
      --card-width: 480px;
    }

    .card {
      padding: 40px;
    }
  }

  /* --- Mobile: stacked cards, no progress UI ------------------------------ */
  @media (max-width: 767px) {
    .warum__head {
      align-items: flex-start;
    }

    .warum__label {
      display: none;
    }

    .cards {
      display: grid;
      gap: 12px;
      margin-top: 32px;
      padding-inline: var(--gutter);
      overflow: visible;
      scroll-snap-type: none;
    }

    /* Figma 242:87: icon → 20 → title → 20 → text */
    .card {
      gap: 20px;
      width: auto;
      padding: 28px;
    }

    .card__body {
      gap: 20px;
    }

    .card__glow {
      top: -120px;
      left: -40px;
      width: 230px;
      height: 230px;
    }

    .card__icon {
      width: 40px;
      height: 40px;
    }

    .warum__progress {
      display: none;
    }
  }
</style>
