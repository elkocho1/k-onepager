---
/**
 * Warum K+ (spec section 5, Figma 139:72 / mobile 242:81): header with
 * eyebrow, h2 and slider label, a horizontally scrollable row of six cards
 * (five features + one statement) with scroll snapping, and a progress line
 * with counter. Mobile stacks the cards; the progress UI is hidden there.
 * Icons are inlined at build time from public/icons/warum/<icon>.svg.
 *
 * The section is the scroll runway for the desktop pin (phase 7, item 7):
 * src/scripts/warum-slider.ts adds `.warum--pinned`, sets the runway height
 * and sticks the inner block while the vertical scroll pushes the card row
 * sideways. Without JS, below 1024px and at reduced motion the section is
 * exactly the native slider described above.
 */
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { content } from '../lib/content';

const { warumKplus } = content;
const total = warumKplus.cards.length + 1; // + statement card
const pad = (n: number) => String(n).padStart(2, '0');

const icons = Object.fromEntries(
  await Promise.all(
    warumKplus.cards.map(async (card) => [
      card.icon,
      await readFile(path.join(process.cwd(), 'public', 'icons', 'warum', `${card.icon}.svg`), 'utf8'),
    ]),
  ),
) as Record<string, string>;
---

<section id={warumKplus.id} class="warum" data-warum>
  <div class="warum__sticky" data-warum-sticky>
    <div class="container warum__head" data-reveal>
      <div class="warum__heading">
        <p class="eyebrow warum__eyebrow">{warumKplus.eyebrow}</p>
        <h2 class="h2">{warumKplus.headline}</h2>
      </div>
      <p class="warum__label">{warumKplus.sliderLabel}</p>
    </div>

    <div class="warum__slider" data-warum-slider>
      <ul class="cards" role="list" tabindex="0" aria-label={warumKplus.trackLabel} data-cards data-lenis-prevent-horizontal>
        {warumKplus.cards.map((card) => (
          <li class="card" data-hex-block>
            <span class="card__glow" aria-hidden="true" data-card-glow></span>
            <span class="card__icon" set:html={icons[card.icon]} />
            <div class="card__body">
              <h3 class="card__title">{card.title}</h3>
              <p class="card__text">{card.text}</p>
            </div>
          </li>
        ))}
        <li class="card card--statement" data-hex-block>
          <span class="card__glow" aria-hidden="true" data-card-glow></span>
          <p class="card__statement">{warumKplus.statement}</p>
        </li>
      </ul>
    </div>

    <div class="container warum__progress" aria-hidden="true">
      <div class="progress">
        <span class="progress__bar" style={`--progress: ${1 / total}`} data-progress-bar></span>
      </div>
      <span class="progress__count" data-progress-count>{pad(1)}/{pad(total)}</span>
    </div>
  </div>
</section>

<script src="../scripts/warum-slider.ts"></script>

<style>
  .warum {
    margin-top: var(--section-gap);
  }

  .warum__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .warum__heading {
    display: flex;
    flex-direction: column;
    gap: var(--gap-head);
  }

  .warum__eyebrow {
    max-width: 163px;
    white-space: normal;
  }

  .warum__label {
    flex: none;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--c-muted);
  }

  /* --- Card track --------------------------------------------------------- */
  .cards {
    /* Start edge = container edge (gutter, or centred container above 1920) */
    --track-start: max(var(--gutter), calc((100% - var(--container)) / 2));
    --card-width: 636px;
    display: flex;
    gap: 32px;
    margin-top: 40px;
    /* Trailing space lets the last card snap to the same start edge */
    padding-inline: var(--track-start) calc(100% - var(--track-start) - var(--card-width));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--track-start);
    scrollbar-width: none;
  }

  .cards::-webkit-scrollbar {
    display: none;
  }

  .cards:focus-visible {
    outline-offset: -3px;
  }

  .card {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 100px;
    width: var(--card-width);
    padding: 50px;
    overflow: hidden;
    border: 1px solid var(--c-night);
    background: var(--c-card-bg);
    scroll-snap-align: start;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .card__glow {
    position: absolute;
    top: -170px;
    left: -1px;
    width: 384px;
    height: 384px;
    border-radius: 50%;
    background: linear-gradient(142deg, var(--c-lime-a10) 43%, transparent 96%);
    filter: blur(32px);
    opacity: 0.5;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .card__icon {
    position: relative;
    display: block;
    width: 50px;
    height: 50px;
    color: var(--c-magenta);
  }

  .card__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .card__title {
    font-size: var(--fs-h3-card);
    font-weight: 400;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--c-teal);
  }

  .card__text {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-white);
  }

  .card--statement {
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .card__statement {
    position: relative;
    max-width: 536px;
    font-size: var(--fs-statement);
    line-height: var(--lh-statement);
    color: var(--c-teal);
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--c-teal-a30);
    }

    .card:hover .card__glow {
      opacity: 1;
    }
  }

  /* --- Progress line + counter -------------------------------------------- */
  /* Figma 139:185 is an 11px row with the counter overflowing it; the
     28px line box of the counter would otherwise push the following sections
     down by 17px. */
  .warum__progress {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 11px;
    margin-top: 40px;
  }

  .progress {
    position: relative;
    flex: 1 1 auto;
    max-width: 1540px;
    height: 1px;
    background: var(--c-teal-a30);
  }

  .progress__bar {
    position: absolute;
    inset: 0;
    background: var(--c-magenta); /* Figma 139:188 – active state, not text */
    /* Fill from warum-slider.ts; with motion GSAP eases an inline transform
       over it (animations.ts) – no CSS transition, it would fight that */
    transform: scaleX(var(--progress, 0.1667));
    transform-origin: left center;
  }

  .progress__count {
    flex: none;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  /* --- Scroll pin (desktop, motion – class and values from warum-slider.ts)
     The section is the runway (block height + overflow × PIN_TRAVEL), the
     block sticks with its bottom edge on the bottom of the viewport, the
     slider clips the row at the viewport edges and the track is translated
     instead of scrolled. The end padding equals the start padding, so at the
     end of the runway the last card is flush with the container's right edge. */
  .warum--pinned {
    height: var(--warum-pin-height);
    scroll-margin-top: var(--warum-pin-margin, 0px);
  }

  .warum--pinned .warum__sticky {
    position: sticky;
    top: var(--warum-pin-top, 0px);
  }

  .warum--pinned .warum__slider {
    overflow-x: clip;
  }

  .warum--pinned .cards {
    padding-inline-end: var(--track-start);
    overflow: visible;
    scroll-snap-type: none;
    will-change: transform;
  }

  /* --- 1024–1439: narrower cards (phase 6) -------------------------------- */
  @media (max-width: 1439px) {
    .cards {
      --card-width: 560px;
    }
  }

  /* --- Tablet: scrollable, narrower cards --------------------------------- */
  @media (max-width: 1023px) {
    .cards {
      --card-width: 480px;
    }

    .card {
      padding: 40px;
    }
  }

  /* --- Mobile: stacked cards, no progress UI ------------------------------ */
  @media (max-width: 767px) {
    .warum__head {
      align-items: flex-start;
    }

    .warum__label {
      display: none;
    }

    .cards {
      display: grid;
      gap: 12px;
      margin-top: 32px;
      padding-inline: var(--gutter);
      overflow: visible;
      scroll-snap-type: none;
    }

    /* Figma 242:87: icon → 20 → title → 20 → text */
    .card {
      gap: 20px;
      width: auto;
      padding: 28px;
    }

    .card__body {
      gap: 20px;
    }

    .card__glow {
      top: -120px;
      left: -40px;
      width: 230px;
      height: 230px;
    }

    .card__icon {
      width: 40px;
      height: 40px;
    }

    .warum__progress {
      display: none;
    }
  }
</style>
