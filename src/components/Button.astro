---
/**
 * Outline button as a link (spec "Buttons"): primary = magenta, secondary =
 * white with a light teal fill. Styles live in global.css (.btn, .btn--*).
 * Remaining attributes (data-*, aria-*, parent scope) are spread onto the <a>.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
}

const { href, label, variant = 'primary', class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, className]} {...rest}>{label}</a>
