---
/**
 * Vision (spec section 2, Figma 139:45 / mobile 242:46): photo left
 * (778×650), eyebrow / h2 / two paragraphs right (702), vertically centred.
 * Mobile: photo (342×260) above the text.
 */
import { Picture } from 'astro:assets';
import { content } from '../lib/content';
import { resolveImage } from '../lib/images';

const { vision } = content;
const image = resolveImage(vision.image.src);
---

<section id={vision.id} class="vision">
  <div class="container vision__grid">
    <Picture
      src={image}
      alt={vision.image.alt}
      widths={[342, 684, 778, 1556]}
      sizes="(min-width: 1024px) 778px, 100vw"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
      class="vision__image"
      pictureAttributes={{ class: 'vision__picture', 'data-reveal': '' }}
    />
    <!-- Eyebrow, h2 and each paragraph are direct children, so the section
         reveal (animations.ts, data-reveal-stagger) staggers them one by one
         with the same travel, duration and threshold as every [data-reveal] -->
    <div class="vision__text" data-reveal-stagger>
      <p class="eyebrow">{vision.eyebrow}</p>
      <h2 class="h2">{vision.headline}</h2>
      {vision.paragraphs.map((paragraph) => <p class="body">{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .vision {
    margin-top: 80px; /* hero 0–936 → vision 1016 (spec) */
  }

  .vision__grid {
    display: grid;
    grid-template-columns: 778px 702px;
    gap: 120px;
    align-items: center;
  }

  .vision :global(.vision__picture) {
    display: block;
    width: 100%;
    aspect-ratio: 778 / 650;
  }

  .vision :global(.vision__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%; /* crop slightly to the right (spec) */
  }

  /* Eyebrow pattern: eyebrow → 24 → h2 → 24 → body, paragraphs 16 apart.
     Sibling margins instead of a flex gap plus a copy wrapper, so every text
     element is a direct child (see the markup note above). */
  .vision__text {
    display: flex;
    flex-direction: column;
  }

  .vision__text > * + * {
    margin-top: var(--gap-head);
  }

  .vision__text > .body + .body {
    margin-top: 16px;
  }

  /* Below 1920 the container is narrower than 1600 – proportional columns */
  @media (max-width: 1919px) {
    .vision__grid {
      grid-template-columns: minmax(0, 778fr) minmax(0, 702fr);
    }
  }

  @media (max-width: 1439px) {
    .vision__grid {
      gap: 64px;
    }
  }

  /* Tablet: stacked (spec breakpoints), photo keeps the desktop crop */
  @media (max-width: 1023px) {
    .vision__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* Mobile frame 242:46: photo 342×260 at 72, text 28 below */
  @media (max-width: 767px) {
    .vision {
      margin-top: var(--section-gap);
    }

    .vision__grid {
      gap: 28px;
    }

    .vision :global(.vision__picture) {
      aspect-ratio: 342 / 260;
    }
  }
</style>
