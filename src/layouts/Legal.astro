---
/**
 * Layout for the legal pages (Impressum, Datenschutz): narrow text column,
 * placeholder copy and `noindex` until the client delivers the texts
 * (content/de.json legal.noindex – astro.config.mjs reads the same flag to
 * keep the pages out of the sitemap). Once real content exists, pass it via
 * the default slot and set the flag to false.
 */
import Base from './Base.astro';
import { content } from '../lib/content';

type LegalPageKey = keyof typeof content.legal.pages;

interface Props {
  page: LegalPageKey;
  noindex?: boolean;
}

const { legal } = content;
const { page: key, noindex = legal.noindex } = Astro.props;
const page = legal.pages[key];
---

<Base title={page.metaTitle} description={page.description} noindex={noindex}>
  <article class="legal container">
    <h1 class="legal__title">{page.title}</h1>
    <p class="legal__placeholder">{legal.placeholder}</p>
    <slot />
    <a href="/" class="legal__back">{legal.backLabel}</a>
  </article>
</Base>

<style>
  .legal {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 820px;
    padding-block: calc(var(--nav-top) + var(--nav-height) + var(--section-gap)) var(--section-gap);
  }

  .legal__title {
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--c-teal);
  }

  .legal :global(h2) {
    margin-top: 16px;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: var(--lh-h2);
    color: var(--c-lime);
  }

  .legal :global(p) {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-white);
  }

  .legal :global(a) {
    color: var(--c-teal);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .legal__back {
    align-self: flex-start;
    margin-top: 24px;
  }
</style>
