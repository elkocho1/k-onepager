---
import Base from '../layouts/Base.astro';
import { content } from '../lib/content';

const { meta, hero } = content;
---

<Base title={meta.title} description={meta.description}>
  <!-- Phase 0 placeholder – replaced by <Hero> in phase 1 -->
  <section class="placeholder container">
    <h1>
      {
        hero.headline.map((line, index) => (
          <span class:list={{ 'outline-text': index === 1 }}>{line}</span>
        ))
      }
    </h1>
  </section>
</Base>

<style>
  .placeholder {
    display: grid;
    place-content: center;
    min-height: 100vh;
  }

  h1 {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: var(--lh-display);
  }

  h1 span {
    display: block;
  }
</style>
