---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Vision from '../components/Vision.astro';
import Mission from '../components/Mission.astro';
import Marquee from '../components/Marquee.astro';
import WarumKplus from '../components/WarumKplus.astro';
import Portfolio from '../components/Portfolio.astro';
import { content } from '../lib/content';

const { meta, schwerpunkte, founder, cta } = content;

/** Empty anchor targets until each section is built in the phase noted. */
const placeholders = [
  { id: schwerpunkte.id, phase: 5 },
  { id: founder.id, phase: 5 },
  { id: cta.id, phase: 5 },
];
---

<Base title={meta.title} description={meta.description}>
  <Hero />
  <Vision />
  <Mission />
  <Marquee />
  <WarumKplus />
  <Portfolio />
  {placeholders.map(({ id, phase }) => <section id={id} class="placeholder" data-phase={phase}></section>)}
</Base>

<style>
  /* Placeholders – replaced by the real sections (see data-phase) */
  .placeholder {
    min-height: 400px;
    margin-top: var(--section-gap);
  }
</style>
